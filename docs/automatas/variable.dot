digraph VARIABLE {
	rankdir=LR
	"" [shape=point]
	Anonima [label="Anonima\n[VARIABLE_ANONIMA]" penwidth=1 shape=doublecircle]
	Inicio [label=Inicio penwidth=1 shape=circle]
	Variable [label="Variable\n[VARIABLE]" penwidth=1 shape=doublecircle]
	"" -> Inicio
	Inicio -> Anonima [label=guion_bajo]
	Inicio -> Variable [label=mayuscula]
	Anonima -> Variable [label="digito, guion_bajo, mayuscula, minuscula"]
	Variable -> Variable [label="digito, guion_bajo, mayuscula, minuscula"]
}
