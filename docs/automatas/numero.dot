digraph NUMERO {
	rankdir=LR
	"" [shape=point]
	Entero [label="Entero\n[ENTERO]" penwidth=1 shape=doublecircle]
	EnteroPunto [label=EnteroPunto penwidth=1 shape=circle]
	Inicio [label=Inicio penwidth=1 shape=circle]
	Real [label="Real\n[REAL]" penwidth=1 shape=doublecircle]
	"" -> Inicio
	Inicio -> Entero [label=digito]
	Entero -> Entero [label=digito]
	Entero -> EnteroPunto [label="."]
	EnteroPunto -> Real [label=digito]
	Real -> Real [label=digito]
}
